# Spotify app
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_CALLBACK_PORT=8888

# MCP endpoint
MCP_AUTH_TOKEN=replace-with-a-long-random-token
MCP_PUBLISH_ADDR=127.0.0.1
MCP_PUBLISH_PORT=8765
MCP_ALLOWED_ORIGINS=

# Runtime
LOG_LEVEL=info
TOKEN_PATH=/data/token.json
